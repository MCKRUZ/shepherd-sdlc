{
  "name": "sdlc-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop shell for the Shepherd plugin — optional add-on, the plugin stays fully usable standalone.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
